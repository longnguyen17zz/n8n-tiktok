# ===== Cấu hình DÙNG CHUNG cho toàn bộ app (không theo từng account/license key) =====
PORT=3005
NODE_ENV=production

# Bắt buộc: connection string Postgres (tạo 1 Postgres database miễn phí trên Render, hoặc dùng
# Postgres local khi dev). Lưu toàn bộ license key + cấu hình account — KHÔNG dùng SQLite file vì
# web service Free của Render không có Persistent Disk, dữ liệu file sẽ mất khi instance restart.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Mật khẩu trang quản trị license key (/admin.html). BẮT BUỘC đổi giá trị này trước khi public app.
ADMIN_SECRET=doi-mat-khau-admin-nay-truoc-khi-public

# OAuth Client ID/Secret của app (đăng ký trên Google Cloud Console) — dùng chung cho MỌI account,
# mỗi account tự "Đăng nhập Drive (OAuth)" và cấp quyền/token Google Drive riêng của họ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/auth/google/callback

# ===== Giá trị mặc định/fallback khi 1 account CHƯA tự cấu hình trong trang "Cấu hình & Tích hợp" =====
# Từ bản multi-tenant trở đi, các field dưới đây nên được từng account tự nhập qua giao diện web
# (lưu trong database theo account) thay vì sửa trực tiếp ở đây. Giữ lại trong .env chỉ để làm giá
# trị mặc định ban đầu (ví dụ cho account bootstrap đầu tiên khi nâng cấp từ bản single-tenant cũ).
SHEET_DOCUMENT_ID=
DRIVE_OUTPUT_FOLDER_ID=
FLOW_PROJECT_ID=
ENGINE=vids
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
N8N_TIKTOK_WEBHOOK_URL=
TIKTOK_SESSION_JSON=
TIKTOK_PROXY_URL=
TIKTOK_AUTO_PUBLISH=false
TIKTOK_POST_MODE=manual
